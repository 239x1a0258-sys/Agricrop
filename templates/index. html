<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriCrop - Crop Disease Detection</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #e8f5e9, #ffffff);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
        }

        .container {
            width: 100%;
            max-width: 900px;
            background: white;
            border-radius: 25px;
            padding: 40px;
            text-align: center;
            box-shadow: 0 10px 35px rgba(0,0,0,0.12);
        }

        .logo {
            font-size: 45px;
            margin-bottom: 5px;
        }

        h1 {
            color: #16843b;
            font-size: 42px;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #555;
            font-size: 18px;
            margin-bottom: 20px;
        }

        .languages {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .lang-btn {
            padding: 12px 25px;
            border: 2px solid #159447;
            background: white;
            color: #159447;
            border-radius: 12px;
            font-size: 16px;
            cursor: pointer;
        }

        .lang-btn:hover,
        .lang-btn.active {
            background: #159447;
            color: white;
        }

        .upload-box {
            border: 2px dashed #22a65a;
            border-radius: 18px;
            padding: 35px;
            background: #f6fff8;
            margin-bottom: 25px;
        }

        .upload-icon {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .upload-text {
            font-size: 18px;
            color: #444;
            margin-bottom: 20px;
        }

        input[type="file"] {
            width: 100%;
            max-width: 450px;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 10px;
            background: white;
        }

        .predict-btn {
            background: #159447;
            color: white;
            border: none;
            padding: 15px 40px;
            font-size: 18px;
            border-radius: 12px;
            cursor: pointer;
        }

        .predict-btn:hover {
            background: #0d7335;
        }

        .voice-section {
            margin: 25px 0;
        }

        .voice-title {
            color: #555;
            font-size: 17px;
            margin-bottom: 12px;
        }

        .voice-btn {
            background: #159447;
            color: white;
            border: none;
            padding: 13px 30px;
            font-size: 17px;
            border-radius: 12px;
            cursor: pointer;
        }

        .features {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-top: 30px;
        }

        .feature {
            flex: 1;
            padding: 20px;
            border-radius: 15px;
            background: #f5faf6;
        }

        .feature-icon {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .feature h3 {
            color: #16843b;
            margin-bottom: 8px;
        }

        .feature p {
            color: #666;
            font-size: 14px;
            line-height: 1.5;
        }

        .footer {
            margin-top: 30px;
            color: #999;
            font-size: 13px;
        }

        @media (max-width: 650px) {
            .container {
                padding: 25px;
            }

            h1 {
                font-size: 32px;
            }

            .features {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="logo">🌱</div>

    <h1>AgriCrop</h1>

    <p class="subtitle" id="subtitle">
        AI-Powered Crop Disease Detection
    </p>

    <div class="languages">

        <button type="button" class="lang-btn active"
                onclick="changeLanguage('en', this)">
            🇬🇧 English
        </button>

        <button type="button" class="lang-btn"
                onclick="changeLanguage('te', this)">
            🇮🇳 తెలుగు
        </button>

        <button type="button" class="lang-btn"
                onclick="changeLanguage('hi', this)">
            🇮🇳 हिन्दी
        </button>

    </div>

    <form action="/predict" method="POST" enctype="multipart/form-data">

        <div class="upload-box">

            <div class="upload-icon">🍃</div>

            <p class="upload-text" id="uploadText">
                Upload a crop leaf image to detect the disease
            </p>

            <input type="file" name="image" accept="image/*" required>

        </div>

        <button type="submit" class="predict-btn" id="predictBtn">
            🔍 Predict Disease
        </button>

    </form>

    <div class="voice-section">

        <div class="voice-title" id="voiceTitle">
            🔊 Listen to information
        </div>

        <button type="button" class="voice-btn"
                id="voiceBtn" onclick="speakInfo()">
            🔊 Listen
        </button>

    </div>

    <div class="features">

        <div class="feature">
            <div class="feature-icon">🤖</div>
            <h3 id="feature1Title">AI Detection</h3>
            <p id="feature1Text">
                Detect crop diseases using a trained deep learning model.
            </p>
        </div>

        <div class="feature">
            <div class="feature-icon">⚡</div>
            <h3 id="feature2Title">Fast Results</h3>
            <p id="feature2Text">
                Get disease predictions and confidence scores quickly.
            </p>
        </div>

        <div class="feature">
            <div class="feature-icon">🌿</div>
            <h3 id="feature3Title">Crop Care</h3>
            <p id="feature3Text">
                Get useful treatment and prevention recommendations.
            </p>
        </div>

    </div>

    <div class="footer">
        AgriCrop © 2026 | Crop Disease Detection System
    </div>

</div>

<script>

let currentLanguage = "en";

const translations = {

    en: {
        subtitle: "AI-Powered Crop Disease Detection",
        upload: "Upload a crop leaf image to detect the disease",
        predict: "🔍 Predict Disease",
        voiceTitle: "🔊 Listen to information",
        voice: "🔊 Listen",
        f1: "AI Detection",
        f1text: "Detect crop diseases using a trained deep learning model.",
        f2: "Fast Results",
        f2text: "Get disease predictions and confidence scores quickly.",
        f3: "Crop Care",
        f3text: "Get useful treatment and prevention recommendations."
    },

    te: {
        subtitle: "AI ఆధారిత పంట వ్యాధి గుర్తింపు",
        upload: "వ్యాధిని గుర్తించడానికి పంట ఆకుల చిత్రాన్ని అప్‌లోడ్ చేయండి",
        predict: "🔍 వ్యాధిని గుర్తించండి",
        voiceTitle: "🔊 సమాచారాన్ని వినండి",
        voice: "🔊 వినండి",
        f1: "AI గుర్తింపు",
        f1text: "శిక్షణ పొందిన డీప్ లెర్నింగ్ మోడల్ ఉపయోగించి పంట వ్యాధులను గుర్తించండి.",
        f2: "వేగవంతమైన ఫలితాలు",
        f2text: "వ్యాధి అంచనా మరియు నమ్మక స్థాయిని త్వరగా పొందండి.",
        f3: "పంట సంరక్షణ",
        f3text: "చికిత్స మరియు నివారణకు ఉపయోగకరమైన సూచనలు పొందండి."
    },

    hi: {
        subtitle: "AI आधारित फसल रोग पहचान",
        upload: "रोग का पता लगाने के लिए फसल के पत्ते की तस्वीर अपलोड करें",
        predict: "🔍 रोग की पहचान करें",
        voiceTitle: "🔊 जानकारी सुनें",
        voice: "🔊 सुनें",
        f1: "AI पहचान",
        f1text: "प्रशिक्षित डीप लर्निंग मॉडल का उपयोग करके फसल रोगों की पहचान करें।",
        f2: "तेज़ परिणाम",
        f2text: "रोग की भविष्यवाणी और विश्वास स्तर जल्दी प्राप्त करें।",
        f3: "फसल देखभाल",
        f3text: "उपचार और रोकथाम के लिए उपयोगी सुझाव प्राप्त करें।"
    }
};

function changeLanguage(lang, button) {

    currentLanguage = lang;

    let t = translations[lang];

    document.getElementById("subtitle").innerText = t.subtitle;
    document.getElementById("uploadText").innerText = t.upload;
    document.getElementById("predictBtn").innerText = t.predict;
    document.getElementById("voiceTitle").innerText = t.voiceTitle;
    document.getElementById("voiceBtn").innerText = t.voice;

    document.getElementById("feature1Title").innerText = t.f1;
    document.getElementById("feature1Text").innerText = t.f1text;

    document.getElementById("feature2Title").innerText = t.f2;
    document.getElementById("feature2Text").innerText = t.f2text;

    document.getElementById("feature3Title").innerText = t.f3;
    document.getElementById("feature3Text").innerText = t.f3text;

    document.querySelectorAll(".lang-btn")
        .forEach(btn => btn.classList.remove("active"));

    button.classList.add("active");

    window.speechSynthesis.cancel();
}

function speakInfo() {

    if (!("speechSynthesis" in window)) {
        alert("Voice is not supported in this browser.");
        return;
    }

    window.speechSynthesis.cancel();

    let text = "";
    let language = "en-IN";

    if (currentLanguage === "te") {

        text =
        "అగ్రిక్రాప్‌కు స్వాగతం. " +
        "ఈ సిస్టమ్ ఆర్టిఫిషియల్ ఇంటెలిజెన్స్ ఉపయోగించి పంట వ్యాధులను గుర్తిస్తుంది. " +
        "పంట ఆకుల చిత్రాన్ని అప్‌లోడ్ చేసి వ్యాధిని గుర్తించండి బటన్‌ను క్లిక్ చేయండి. " +
        "వ్యాధి పేరు, నమ్మక స్థాయి, చికిత్స మరియు నివారణ సూచనలు పొందవచ్చు.";

        language = "te-IN";

    } else if (currentLanguage === "hi") {

        text =
        "एग्रीक्रॉप में आपका स्वागत है। " +
        "यह सिस्टम आर्टिफिशियल इंटेलिजेंस का उपयोग करके फसल के रोगों की पहचान करता है। " +
        "फसल के पत्ते की तस्वीर अपलोड करें और रोग की पहचान करें बटन दबाएं। " +
        "आपको रोग का नाम, विश्वास स्तर, उपचार और रोकथाम की जानकारी मिलेगी।";

        language = "hi-IN";

    } else {

        text =
        "Welcome to AgriCrop. " +
        "This system uses artificial intelligence to detect crop diseases. " +
        "Upload a crop leaf image and click Predict Disease. " +
        "You will get the disease name, confidence score, treatment and prevention recommendations.";

        language = "en-IN";
    }

    let speech = new SpeechSynthesisUtterance(text);

    speech.lang = language;
    speech.rate = 0.85;
    speech.pitch = 1;
    speech.volume = 1;

    document.getElementById("voiceBtn").innerText =
        "🔊 Speaking...";

    speech.onend = function() {
        document.getElementById("voiceBtn").innerText =
            translations[currentLanguage].voice;
    };

    speech.onerror = function() {
        document.getElementById("voiceBtn").innerText =
            translations[currentLanguage].voice;

        alert("Voice could not be played.");
    };

    window.speechSynthesis.speak(speech);
}

</script>

</body>
</html>
